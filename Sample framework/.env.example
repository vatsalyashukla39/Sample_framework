# Test environment selection (local | dev | qa | staging)
TEST_ENV=qa

# Override URLs (optional — defaults per env are in src/config/env.ts)
# BASE_URL=https://qa.example.com
# API_BASE_URL=https://qa.example.com/api

# Credentials (REQUIRED). Never commit real secrets — use a secret manager in CI.
TEST_USER=changeme
TEST_PASSWORD=changeme
